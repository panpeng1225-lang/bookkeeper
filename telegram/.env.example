# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_PORT=8787
TELEGRAM_BOT_HOST=0.0.0.0
TELEGRAM_DEFAULT_CURRENCY=RMB

# Supabase for Telegram writes
# If omitted, the server will fall back to VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY
TELEGRAM_SUPABASE_URL=
TELEGRAM_SUPABASE_ANON_KEY=

# Volcengine Speech-to-Text (old async AUC API)
VOLCENGINE_SPEECH_APPID=
VOLCENGINE_SPEECH_TOKEN=
VOLCENGINE_SPEECH_CLUSTER=volc_auc_common
VOLCENGINE_SPEECH_SUBMIT_URL=https://openspeech.bytedance.com/api/v1/auc/submit
VOLCENGINE_SPEECH_QUERY_URL=https://openspeech.bytedance.com/api/v1/auc/query
VOLCENGINE_SPEECH_POLL_MS=1500
VOLCENGINE_SPEECH_TIMEOUT_MS=45000
